@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PAN Validation</title>
    <!-- jQuery (only once, already included with Kendo usually) -->
    <script src="~/Scripts/jquery.min.js"></script>

    <!-- Kendo UI -->
    <script src="~/Scripts/kendo.all.min.js"></script>
    <link href="~/Content/kendo.default.min.css" rel="stylesheet" />

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <style>
        /* White rows */
        /* Alternate rows – Blue */
        #dividendGrid .k-grid-content tr.k-alt td {
            background-color: #5997bb !important;
            color: #ffffff;
        }

        /* Normal rows – White */
        /* #dividendGrid .k-grid-content tr td {
                    background-color: #ffffff;
                }      */

        /* Cell borders */
        #dividendGrid td {
            border: 1px solid #cfd8dc;
        }

        /* Compact row height */
        #dividendGrid .k-grid-content td {
            padding-top: 4px;
            padding-bottom: 4px;
        }

        /* Fixed layout */
        #dividendGrid .k-grid-header table,
        #dividendGrid .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #dividendGrid .k-grid-header th,
        #dividendGrid .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #dividendGrid .k-grid-content td {
            padding-top: 4px;
            padding-bottom: 4px;
            line-height: 18px;
            font-size: 13px;
        }

        #dividendGrid .k-grid-header th {
            padding-top: 4px;
            padding-bottom: 4px;
            line-height: 18px;
            font-size: 13px;
        }

        #dividendGrid .k-grid-content {
            height: 287px !important;
        }

    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body">
                <form id="formAccountSettings" method="POST" onsubmit="return false">
                    <div class="row" id="listSection">
                        <div class="col-sm-12">                            
                            @* <a href="../Registration/Registration"><img id="plusIcon" style="width:15px; height:15px;margin-bottom:12px;cursor:pointer;float:right;" src="~/Assets/images/toplist.png" /></a> *@
                            <div id="dividendGrid"></div>
                        </div>
                    </div>

                    <div id="NewSection" style="display:none;">
                        <div class="row">
                            <div class="col-sm-12">
                                <img id="listIcon1" style="width:16px; height:16px;margin-bottom:12px;float:right;cursor:pointer" src="~/Assets/images/toplist.png" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <input hidden type="number" id="dividend_gid" value="0" class="form-control" />
                                <input type="hidden" id="compgrp_gid" />
                                <label class="form-label" for="cname">Company Name</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select class="form-control" id="company" readonly>
                                </select>
                                <span id="queryCompany" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="isin">ISIN</label>
                                <input type="text" class="form-control" id="isin" disabled />
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="dyear">RBI Code</label>
                                <input type="text" id="rbicode" class="form-control" readonly />
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="dyear">Dividend Year</label>
                                <input type="text" id="dyear" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="col-sm-3">
                                <label class="form-label" for="remarks">Dividend Type</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select id="divdtype" class="form-control" readonly>
                                    <option value="">--- Select --- </option>
                                    <option value="Interim 1">Interim 1</option>
                                    <option value="Interim 2">Interim 2</option>
                                    <option value="Interim 3">Interim 3</option>
                                    <option value="Final">Final</option>
                                </select>
                                <span id="querydivdtype" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="remarks">Remarks / Description</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="text" id="remarks" class="form-control" readonly />
                                <span id="queryremarks" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="drate">Dividend Rate (%)</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="number" class="form-control" min="1" id="drate" placeholder="Enter %" oninput="calculateDividend()" readonly />
                                <span id="querydivdrate" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="remarks">Face Value</label>
                                <input type="text" class="form-control" id="faceValue" value="10" readonly />
                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="col-sm-3">
                                <label class="form-label" for="remarks">Dividend Per Share</label>
                                <input type="text" class="form-control" id="dividendPerShare" readonly />
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="cname">Bank Name</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select class="form-control" id="bank"  readonly>
                                    <option value="">--- Select ----</option>
                                    <option value="HDFC Bank" data-ifsc="HDFC0000128">HDFC Bank</option>
                                    <option value="ICICI Bank" data-ifsc="ICIC0000077">ICICI Bank</option>
                                    <option value="Axis Bank" data-ifsc="UTIB0000006">Axis Bank</option>
                                </select>
                                <span id="querybank" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="remarks">IFSC Code</label>
                                <input type="text" id="ifsc" class="form-control" readonly />
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="remarks">Dividend Account No</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="text" id="divacno" class="form-control" readonly />
                                <span id="querydivacno" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="col-sm-3">
                                <label class="form-label" for="dyear">Dividend Cutoff Date</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="date" id="cutoffdate" class="form-control" readonly />
                                <span id="querycutoffdate" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="dyear">Dividend Payment Date</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="date" id="paymentdate" class="form-control" readonly />
                                <span id="querypaymentdate" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <center><button type="button" class="btn btn-primary" onclick="downloadpan()" style="padding: 3px 25px;margin-top:28px;">Download PAN Master</button></center>
                            </div>
                            <div class="col-sm-3">
                                <label for="formFile" class="form-label">PAN Master Upload</label>
                                <input class="form-control" type="file" id="formFile" multiple />
                                <span id="uploadError" class="text-danger mt-1" style="font-size:13px;"></span>
                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="col-sm-4">

                            </div>
                            <div class="col-sm-4">
                                <center><button type="button" id="btnSave" class="btn btn-primary" onclick="pansave()" style="padding: 3px 25px;margin-top:28px;" disabled>Save</button></center>
                            </div>
                            <div class="col-sm-4">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>

</html>

<script>
    var expectedRowCount = 0;
    var uploadedPanData = [];        
       $( document ).ready(function() {
              $('#navhead').text('PAN Validation');

               showgrid();
              const currentYear = new Date().getFullYear();
              const previousYear = currentYear - 1;
              document.getElementById("dyear").value =   `${previousYear} - ${currentYear}`;
        });

        function showgrid() {
                   var mymodel = {
                    dividendgid: 0,
                    action: "A"
                };
                $.ajax({
                    type: "POST",
                     url: '@Url.Action("DividendList", "PanValidation")',
                     data: JSON.stringify(mymodel),
                     dataType: "json",
                     contentType: 'application/json; charset=utf-8',
                     success: function (data) {
                     console.log("Responses:", data);
                         let columns = [
                            {
                                field: "action",
                                title: "Action",
                                        template: '<center><img src="../Assets/images/editicons.png" name="Edit" id="Edit" value="Edit" onclick="editGrid(this);" style="height:12px;width:12px;cursor:pointer;"></center>',
                                filterable: false,
                                sortable: false,
                                width: 100
                            },
                             {
                                 field: "dividendgid",
                                 title: "ID",
                                 hidden: true
                             },
                             {
                                 field: "company_name",
                                 title: "Company Name"
                             },
                             {
                                 field: "isin",
                                 title: "ISIN"
                             },
                             {
                                 field: "rbicode",
                                 title: "RBI Code"
                             },
                             {
                                    field: "dividend_year",
                                    title: "Dividend Year"
                             },
                             {
                                    field: "dividend_type",
                                     title: "Dividend Type"
                             },
                            {
                                    field: "remarks",
                                    title: "Remarks"
                            },
                             {
                                   field: "dividend_rate",
                                    title: "Dividend Rate",
                                    format: "{0:n2}"
                            },
                            {
                                   field: "face_value",
                                    title: "Face Value"
                            },
                            {
                                    field: "dividend_per_share",
                                    title: "Dividend Per Share",
                                    format: "{0:n2}"
                            },
                                {
                                    field: "bank_name",
                                    title: "Bank Name"
                            },
                            {
                                    field: "ifsc_code",
                                    title: "IFSC Code"
                            },
                            {
                                    field: "dividend_account_no",
                                    title: "Dividend Accoun tNo"
                            },
                            {
                                    field: "dividend_cutoff_date",
                                    title: "Cutoff Date"
                            },
                            {
                                   field: "dividend_payment_date",
                                    title: "Payment Date"
                            }

                         ];
                         $('#dividendGrid').append('<div id="example" class="table-responsive text-nowrap" id="chk1"><table id="grid" data-bind="source: gridRows" class="table table-sm" style="width:100%;height: 358px;line-height:1em;font-size:12px;border-bottom: 1px solid #e1e1e1;"></table></div>');
                         var gridData = JSON.parse(data._data);
                         $("#grid").kendoGrid({
                             dataSource: {
                             data: gridData,
                                 pageSize: 10
                             },
                             height: 358,
                             pageable: {
                                 pageSizes: [10, 20, 30],
                                 refresh: true
                             },
                             sortable: true,
                             filterable: true,
                             resizable: true,
                             columns: columns,
                                 dataBound: function () {
                                    var grid = this;
                                    grid.columns.forEach(function (col, index) {
                                        grid.autoFitColumn(index);
                                    });
                                }
                         });
                     },
                     error: function (xhr) {
                         console.log("Error: ", xhr.responseText);
                     }
                 });
        }

         function loadCompany(selectedCompanyName) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("CompDetails", "PanValidation")',
                contentType: "application/json",
                success: function (response) {
                    var result = JSON.parse(response.data);
                    $("#company").empty();
                    $("#company").append('<option value="">--- Select Company ---</option>');
                    $.each(result.Table, function (index, item) {
                            $("#company").append(
                                '<option value="' + item.comp_name +
                                '" data-isin="' + item.isin_id +
                                '" data-compgrp="' + item.compgrp_gid + '">' +
                                item.comp_name +
                                '</option>'
                            );
                    });

                    // ✅ After dropdown loaded, bind selected value
                    if (selectedCompanyName) {
                        $("#company").val(selectedCompanyName);
                        // ✅ Manually fetch selected option
                        var selectedOption = $("#company").find(":selected");
                        var isinValue = selectedOption.data("isin");
                        var compgrpValue = selectedOption.data("compgrp");
                        // ✅ Set values in fields
                        $("#isin").val(isinValue);
                        $("#compgrp_gid").val(compgrpValue);
                        console.log("Edit Mode Values:");
                        console.log("ISIN:", isinValue);
                        console.log("CompGrpGID:", compgrpValue);
                      }
                }
            });
        }     
        
         $('#listIcon1').on('click', function () {
                     $('#listSection').show();
                     $('#NewSection').hide();
          });

        function convertToHtmlDate(dateStr) {
            if (!dateStr) return "";

            var parts = dateStr.split("-"); // ["30","01","2026"]
            return parts[2] + "-" + parts[1] + "-" + parts[0];
        }

    function editGrid(e) {
            $('#listSection').hide();
            $('#NewSection').show();
             var grid = $("#grid").data("kendoGrid");
             var row = $(e).closest("tr");
            var rowData = grid.dataItem(row);
            console.log("Editing Row:", rowData);
            loadCompany(rowData.company_name);
            $("#isin").val(rowData.isin);
            $("#dividend_gid").val(rowData.dividend_gid);
            $("#compgrp_gid").val(rowData.compgrp_gid);
            $("#dyear").val(rowData.dividend_year);
            $("#divdtype").val(rowData.dividend_type);
            $("#remarks").val(rowData.remarks);
            $("#drate").val(rowData.dividend_rate);
            $("#faceValue").val(rowData.face_value);
            $("#dividendPerShare").val(rowData.dividend_per_share);
            $("#bank").val(rowData.bank_name);
            $("#ifsc").val(rowData.ifsc_code);
            $("#divacno").val(rowData.dividend_account_no);
            $("#cutoffdate").val(convertToHtmlDate(rowData.dividend_cutoff_date));
            $("#paymentdate").val(convertToHtmlDate(rowData.dividend_payment_date));
            $("#uploadError").text("");
     }


        function downloadpan() {

        var dividendgid = $("#dividend_gid").val();
        var compgrp_gid = $("#compgrp_gid").val();
        var benpodate = $("#cutoffdate").val();

        var mymodel = {
            compgrpgid: compgrp_gid,
            benposdate: benpodate,
            dividendgid: dividendgid
        };

        var xhr = new XMLHttpRequest();
        xhr.open("POST", '@Url.Action("PanValidationProcess", "PanValidation")', true);
        xhr.responseType = "blob";
        xhr.setRequestHeader("Content-Type", "application/json");

        xhr.onload = function () {

            if (xhr.status === 200) {

                var blob = xhr.response;

                // ✅ Just download directl"
                var link = document.createElement("a");
                link.href = window.URL.createObjectURL(blob);
                link.download = "PAN_Validation_Files.zip";
                link.click();

                console.log("Excel Download Completed");

            } else {
                alert("Excel download failed. Status: " + xhr.status);
            }
        };

        xhr.send(JSON.stringify(mymodel));
    }


    document.getElementById('formFile').addEventListener('change', function (e) {

        var files = e.target.files;   // ✅ Multiple files
        var errorDiv = document.getElementById('uploadError');
        var saveBtn = document.getElementById('btnSave');

        var dividendgid = $("#dividend_gid").val();

        errorDiv.textContent = "";
        saveBtn.disabled = true;

        uploadedPanData = [];

        if (!files || files.length === 0) return;

        let allRows = [];
        let filesProcessed = 0;

        // ✅ Read each Excel file
        Array.from(files).forEach(file => {

            var reader = new FileReader();

            reader.onload = function (event) {

                var data = new Uint8Array(event.target.result);
                var workbook = XLSX.read(data, { type: 'array' });

                var firstSheet = workbook.SheetNames[0];
                var worksheet = workbook.Sheets[firstSheet];

                var jsonData = XLSX.utils.sheet_to_json(worksheet, { defval: "" });

                console.log("File:", file.name, "Rows:", jsonData.length);

                // ✅ Merge rows into one dataset
                allRows = allRows.concat(jsonData);

                filesProcessed++;

                // ✅ After all files are processed
                if (filesProcessed === files.length) {

                    console.log("Total Uploaded Rows:", allRows.length);

                    uploadedPanData = allRows;

                    validateUploadedData(allRows, dividendgid);
                }
            };

            reader.readAsArrayBuffer(file);
        });

    });


    function validateUploadedData(jsonData, dividendgid) {

        var errorDiv = document.getElementById('uploadError');
        var saveBtn = document.getElementById('btnSave');

        var allowedStatuses = [];

        // ✅ Fetch Allowed Statuses
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetAllowedPanStatus", "PanValidation")',
            success: function (res) {

                allowedStatuses = res;

                // ✅ Fetch Expected Count from DB
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetExpectedPanCount", "PanValidation")',
                    data: { dividendgid: dividendgid },

                    success: function (res) {

                        if (res.success) {

                            var expectedCount = res.expectedCount;

                            console.log("Expected Count:", expectedCount);
                            console.log("Uploaded Count:", jsonData.length);

                            // ✅ Count Match Check
                            if (jsonData.length === expectedCount) {

                                // ✅ PAN Status Validation
                                var invalidStatuses = [];

                                jsonData.forEach((row, index) => {

                                    var status = row["PAN_Status"]?.trim();

                                    if (!allowedStatuses.includes(status)) {
                                        invalidStatuses.push(index + 2);
                                    }
                                });

                                if (invalidStatuses.length > 0) {

                                    errorDiv.classList.add("text-danger");
                                    errorDiv.textContent =
                                        "Invalid PAN Status found! Allowed: " +
                                        allowedStatuses.join(", ");

                                    saveBtn.disabled = true;
                                    document.getElementById("formFile").value = "";
                                    return;
                                }

                                // ✅ All Passed
                                errorDiv.classList.remove("text-danger");
                                errorDiv.classList.add("text-success");

                                errorDiv.textContent =
                                    "Multiple pan files uploaded successfully";

                                saveBtn.disabled = false;

                                } else if (jsonData.length < expectedCount) {

                                // ✅ Missing Records
                                var missingRows = expectedCount - jsonData.length;

                                // ✅ Each file contains 500 rows
                                var chunkSize = 500;

                                // ✅ Missing Files Count
                                var missingFiles = Math.ceil(missingRows / chunkSize);

                                errorDiv.classList.remove("text-success");
                                errorDiv.classList.add("text-danger");

                                errorDiv.textContent =
                                    "Upload incomplete! " +
                                    missingFiles + " more file(s) left to upload. " ;

                                saveBtn.disabled = true;
                                return;
                            }
                            else {

                                // ✅ Extra Records Uploaded
                                var extraRows = jsonData.length - expectedCount;

                                errorDiv.classList.remove("text-success");
                                errorDiv.classList.add("text-danger");

                                errorDiv.textContent =
                                    "Too many records uploaded! Extra Rows: " + extraRows;

                                saveBtn.disabled = true;
                                return;
                            }

                        } else {
                            errorDiv.classList.add("text-danger");
                            errorDiv.textContent = "Error: " + res.message;
                        }
                    },

                    error: function () {
                        errorDiv.classList.add("text-danger");
                        errorDiv.textContent =
                            "Unable to fetch expected count from DB!";
                    }
                });

            }
        });
    }

function pansave () {
     var dividendgid = $("#dividend_gid").val();
      var mymodel = { dividendgid:dividendgid, panList: uploadedPanData};
              $.ajax({
            type: "POST",
            url: '@Url.Action("PanUpdateProcess", "PanValidation")',
            data: JSON.stringify(mymodel),
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                $.alert({
                    title: 'STA Web',
                    content: "PAN Detals Updated Successfully!!!!",
                    type: 'green',
                });
                    setTimeout(() => {
                            window.location.href = "../PanValidation/PanValidation";
                }, 3000);
            },
            error: function () {
                    $.alert({
                        title: 'STA Web',
                        content: "Update Failed! Please try again.",
                        type: 'red'
                    });
            }
        });

    }

</script>