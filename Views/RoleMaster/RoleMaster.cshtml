                                <select id="role_application" class="form-select" data-placeholder="Entity" style="margin-bottom:13px;">
                                    <option value=""> -- Select Status--</option>
                                    <option value="Y">Active</option>
                                    <option value="N">Inactive</option>
                                </select>
                                <span id="queryErrorUserstatus" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                        </div>

                        <div class="row"> 
                            

                            <div class="col-sm-3" id="divstatus">
