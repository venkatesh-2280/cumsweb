</body>


</html>
<script type="text/javascript">
    $('#plusIcon').on('click', function () {
             $('#listSection').hide();
             $('#NewSection').show();
             $('#btnSubmit').show();
             $('#btnUpdate').hide();
              $('#divstatus').hide();
             queryErrorucode.textContent = "";
             queryErroruname.textContent = "";
             queryErroremail.textContent = "";
              queryErrorUserrole.textContent = "";
              $("#rolecode").val("");
              $("#rolename").val(""); 
     });
      $('#listIcon1').on('click', function () {
             $('#listSection').show();
             $('#NewSection').hide();
       });

    $(document).ready(function () { 
        $("#navhead").text("Role Master");
        $("#kendoVersion").text(kendo.version); 
        showgrid();
        var data = {}; 
    });


       function showgrid() {
         $.ajax({
             url: '@Url.Action("RoleList", "RoleMaster")',
             type: "POST",
             dataType: "json",
              success: function (response) {
                   if (response.authExpired) {
                                 $.alert({
                                      title: 'Unauthorized',
                                     content: response.message || 'Unauthorized User',
                                     type: 'red',
                                     buttons: {
                                         ok: {
                                             text: 'OK',
                                             action: function () {
                                                 window.location.href = '/login/logout';
                                             }
                                         }
                                     }
                                 });
                                 return;  
                             }
                 let data = response.data;
                 let columns = [
                     {
                         field: "role_gid",
                         title: "ID",
                         hidden: true
                     },
                     {
                         field: "role_code",
                         title: "Role Code"
                     },
                     {
                         field: "role_name",
                         title: "Role Name"
                     },
                    {
                        field: "application_code",
                        title: "App Code"
                    },
                    {
                        field: "application_name",
                        title: "App Name"
                    },
                     {
                         field: "status",
                         title: "Status"
                     }, 
                     {
                         field: "application_gid",
                         title: "application_gid",
                         hidden: true
                     },
                     {
                         field: "action",
                         title: "Action",
                         template: '<center><img src="../Assets/images/editicons.png" name="Edit" id="Edit" value="Edit" onclick="editGrid(this);" style="height:15px;width:15px;cursor:pointer;"></center>',
                         filterable: false,
                         sortable: false,
                         width: 100
                     }
                 ];
                  $('#roleGrid').append('<div id="example" class="table-responsive text-nowrap" id="chk1"><table id="grid" data-bind="source: gridRows" class="table table-sm" style="width:100%;height: 341px;line-height:1em;font-size:12px;border-bottom: 1px solid #e1e1e1;"></table></div>');

                 $("#grid").kendoGrid({
                     dataSource: {
                          data: data,
                         pageSize: 10
                     },
                     height: 341,
                     pageable: {
                         pageSizes: [10, 20, 30],
                         refresh: true
                     },
                     sortable: true,
                     filterable: true,
                     resizable: true,
                     columns: columns
                 });
             },
             error: function (xhr) {
                 console.log("Error: ", xhr.responseText);
             }
         });
     }
</script>

<script>

    $(document).ready(function () {
        loadUserRoles('STAMKR');
            showDynamicGrid();
    });

function showDynamicGrid() {

        $.ajax({
            url: '@Url.Action("UserRoleList", "RoleMaster")',
            type: "GET",
            dataType: "json",
            success: function (response) {

                if (!response.success) {
                    alert("Error loading data");
                    return;
                }

                var data = response.data;

                if (!data || data.length === 0) {
                    alert("No data found");
                    return;
                }

                if ($("#userrole_grid").data("kendoGrid")) {
                    $("#userrole_grid").data("kendoGrid").destroy();
                    $("#userrole_grid").empty();
                }

                var columns = [];
                var firstRow = data[0];
                    for (let key in firstRow) { 
                        columns.push({
                            field: key,
                            title: key, // this is app_name column header
                            width: 180,
                            template: function (dataItem) {

                                let cell = dataItem[key];

                                if (!cell || cell === "") return "";

                                // If JSON string → convert to object
                                if (typeof cell === "string") {
                                    try {
                                        cell = JSON.parse(cell);
                                    } catch (e) {
                                        return "";
                                    }
                                }

                                if (!cell.role_name) return "";

                                return `
                                    <div style="display:flex; align-items:center; gap:6px;">
                                        <input type="checkbox"
                                               class="cellCheckbox"
                                               data-appcode="${cell.app_code}"
                                               data-rolecode="${cell.role_code}" />
                                        <span>${cell.role_name}</span>
                                    </div>
                                `;
                            }
                        });
                    }


                $("#userrole_grid").kendoGrid({
                    dataSource: {
                        data: data,
                        pageSize: 10
                    },
                    pageable: true,
                    sortable: true,
                    filterable: true,
                    resizable: true,
                    height: 400,
                    columns: columns
                });

            }
        });
    }

    $(document).on("change", "#selectAll", function () {
        $(".rowCheckbox").prop("checked", this.checked);
    });
    
      function saveRoles() 
      {

        let selected = []; 
        $("#userrole_grid .cellCheckbox:checked").each(function () { 
            selected.push({ 
                app_code: $(this).data("appcode"),
                role_code: $(this).data("rolecode")
            }); 
        });
        let payload = {
            user_code: $("#user_code").val(),
            roles: selected
        };
        $.ajax({
            url: '@Url.Action("SaveUserRoles", "RoleMaster")',
            type: "POST",
            contentType: "application/json",
             data: JSON.stringify(payload),
            success: function (res) {
                alert("Saved successfully");
            }
        });
    }

     function loadUserRoles(userCode) {

    $.ajax({
        url: '@Url.Action("GetUserRole", "RoleMaster")',
        type: 'GET',
        data: { userCode: userCode },   // ✅ send parameter
        success: function (response) {

            if (!response.success) return;

            let data = response.data;   // ✅ correct array

            let roleMap = new Set(
                data.map(x => x.app_code + "|" + x.role_code)
            );

            $("#userrole_grid .cellCheckbox").each(function () {
                console.log(
                    $(this).data("appcode"),
                    $(this).data("rolecode")
                );
                let key = ($(this).data("appcode") + "|" + $(this).data("rolecode")).toUpperCase();

                $(this).prop("checked", roleMap.has(key));
            });
        }
    });
}


</script>
