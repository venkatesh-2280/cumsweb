    <title>Role Master</title>
    <style>
        #userGrid .k-grid-content tr.k-alt td {
            background-color: #5997bb !important;
            color: #ffffff;
        }

        /* Normal rows – White */
        /* #dividendGrid .k-grid-content tr td {
                            background-color: #ffffff;
                        }      */

        /* Cell borders */
