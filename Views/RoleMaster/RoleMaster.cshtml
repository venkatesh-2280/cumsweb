<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body">
                <form id="formAccountSettings" method="POST" onsubmit="return false">
                    <div class="row" id="listSection">
                        <div class="col-sm-12">
                            <img id="plusIcon" style="width:11px; height:11px;margin-bottom:12px;cursor:pointer" src="~/Assets/images/plus.png" />
                            @* <div id="roleGrid"></div> *@
                        </div>
                        
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-sm-3">
                            <label class="form-label" for="userid">
                                User Code&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                            </label>
                            <input type="text" id="user_code" value="" class="form-control" />
                            <span id="queryErrorucode" style="color: red; font-size: 12px;position:relative;"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">
                            <button onclick="saveRoles()">Save</button><br />
                            <div id="userrole_grid"></div>

                        </div>
                    </div>
                    <div id="NewSection" style="display:none;">
                        <div class="row">
                            <div class="col-sm-12">
                                <img id="listIcon1" style="width:16px; height:16px;margin-bottom:12px;float:right;cursor:pointer" src="~/Assets/images/toplist.png" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <label class="form-label" for="userid">
