            padding-bottom: 4px;
        }

        /* Fixed layout */
        #userrole_grid .k-grid-header table,
        #userrole_grid .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #userrole_grid .k-grid-header th,
        #userrole_grid .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #userrole_grid .k-grid-content td {
            padding-top: 4px;
            padding-bottom: 4px;
            line-height: 18px;
            font-size: 13px;
            color: #000;
        }

        #userrole_grid .k-grid-header th {
