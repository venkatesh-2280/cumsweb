@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var userName = Context.Session.GetString("user_name");
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Rule Engine</title>
    <style>
        #ruleEngineGrid .k-grid-content tr.k-alt td {
            background-color: #5997bb !important;
            color: #ffffff;
        }

        /* Normal rows – White */
        /* #dividendGrid .k-grid-content tr td {
                            background-color: #ffffff;
                        }      */

        /* Cell borders */
        #ruleEngineGrid td {
            border: 1px solid #cfd8dc;
        }

        /* Compact row height */
        #ruleEngineGrid .k-grid-content td {
            padding-top: 2px;
            padding-bottom: 2px;
        }

        /* Fixed layout */
        #ruleEngineGrid .k-grid-header table,
        #ruleEngineGrid .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #ruleEngineGrid .k-grid-header th,
        #ruleEngineGrid .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #ruleEngineGrid .k-grid-content td {
            padding-top: 2px;
            padding-bottom: 2px;
            line-height: 18px;
            font-size: 13px;
        }

        #ruleEngineGrid .k-grid-header th {
            padding-top: 4px;
            padding-bottom: 4px;
            line-height: 18px;
            font-size: 13px;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body">
                <form id="formAccountSettings" method="POST" onsubmit="return false">
                    <div class="row" id="listSection">
                        <div class="col-sm-12">
                            <img id="plusIcon" style="width:11px; height:11px;margin-bottom:12px;cursor:pointer" src="~/Assets/images/plus.png" />
                            @* <a href="../Registration/Registration"><img id="plusIcon" style="width:15px; height:15px;margin-bottom:12px;cursor:pointer;float:right;" src="~/Assets/images/toplist.png" /></a> *@
                            <div id="ruleEngineGrid"></div>
                        </div>
                    </div>

                    <div id="NewSection" style="display:none;">
                        <div class="row">
                            <div class="col-sm-12">
                                <img id="listIcon1" style="width:16px; height:16px;margin-bottom:12px;float:right;cursor:pointer" src="~/Assets/images/toplist.png" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <input hidden type="number" id="rule_gid" value="0" class="form-control" />
                                <label class="form-label" for="isin">Rule Name</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="text" class="form-control" id="rulename" />
                                <span id="queryrname" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label">TDS Type</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select class="form-control" id="tdsType">
                                    <option value="">--- Select ----</option>
                                    <option value="1">0% Government A/C</option>
                                    <option value="2">0% Individual Gross Amount Less than Rs. 10000</option>
                                </select>
                                <span id="querytdstype" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>

                            <div class="col-sm-3">
                                <label class="form-label">Bene Category</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select class="form-control" id="beneCategory" >
                                    <option value="">--- Select ----</option>
                                    <option value="1">IEPF</option>
                                    <option value="2">Individual</option>
                                    <option value="3">KMP</option>
                                    <option value="4">Promoters</option>
                                </select>
                                <span id="querybcat" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="isin">Pan Status</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select class="form-control" id="panstatus" >
                                    <option value="">--- Select ----</option>
                                    <option value="1">Excemption</option>
                                    <option value="2">Inoperative</option>
                                    <option value="3">Operative</option>
                                    <option value="4">(blank)</option>
                                </select>
                                <span id="querypanstatus" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="col-sm-3">
                                <label class="form-label" for="isin">Pan Category</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <select class="form-control" id="pancat" >
                                    <option value="">--- Select ----</option>
                                    <option value="1">Excemption</option>
                                    <option value="2">Individual</option>
                                    <option value="3">Pan Not Available - Individual</option>
                                </select>
                                <span id="querypancat" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label" for="isin">TDS Rate</label>&nbsp;<span style="font-size: 12px;color: red;font-weight: bold;">*</span>
                                <input type="text" class="form-control" id="tdsrate" />
                                <span id="querytdsrate" style="color: red; font-size: 12px;position:relative;"></span>
                            </div>
                            <div class="col-sm-3">
                                <button type="button" class="btn btn-primary" onclick="ruleenginesave()" style="padding: 3px 25px;margin-top:28px;">Save</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>

</html>

<script>
    $( document ).ready(function() {
          $('#navhead').text('Rule Engine');
          showgrid();
    }); 

    function  showgrid() {
        var mymodel = {
                rulegid: 0,
                action: "A"
            };
            $.ajax({
                type: "POST",
                 url: '@Url.Action("RuleEngineList", "RuleEngine")',
                 data: JSON.stringify(mymodel),
                 dataType: "json",
                 contentType: 'application/json; charset=utf-8',
                 success: function (data) {
                 console.log("Responses:", data);
                     let columns = [
                        {
                            field: "action",
                            title: "Action",
                                    template: '<center><img src="../Assets/images/editicons.png" name="Edit" id="Edit" value="Edit" onclick="editGrid(this);" style="height:12px;width:12px;cursor:pointer;">&nbsp;&nbsp;&nbsp;&nbsp;<img src="../Assets/images/del.png" name="delete" id="delete" value="Edit" onclick="deleteGrid(this);" style="height:12px;width:12px;cursor:pointer;"></center>',
                            filterable: false,
                            sortable: false,
                            width: 100
                        },
                         {
                             field: "rule_gid",
                             title: "ID",
                             hidden: true
                         },
                         {
                             field: "rule_name",
                             title: "Rule Name"
                         },
                         {
                             field: "tds_type",
                             title: "TDS Type"
                         },
                         {
                             field: "bene_category",
                             title: "Bene Category"
                         },
                         {
                                field: "pan_status",
                                title: "PAN Status"
                         },
                         {
                                field: "pan_category",
                                 title: "PAN Category"
                         },
                        {
                                field: "tds_rate",
                                title: "TDS Rate"
                        },                        
                        {
                                field: "insert_date",
                                title: "Insert Date"
                        }                       

                     ];
                     $('#ruleEngineGrid').append('<div id="example" class="table-responsive text-nowrap" id="chk1"><table id="grid" data-bind="source: gridRows" class="table table-sm" style="width:100%;height: 358px;line-height:1em;font-size:12px;border-bottom: 1px solid #e1e1e1;"></table></div>');
                     var gridData = JSON.parse(data._data);
                     $("#grid").kendoGrid({
                         dataSource: {
                         data: gridData,
                             pageSize: 10
                         },
                         height: 358,
                         pageable: {
                             pageSizes: [10, 20, 30],
                             refresh: true
                         },
                         sortable: true,
                         filterable: true,
                         resizable: true,
                         columns: columns,
                             dataBound: function () {
                                var grid = this;
                                grid.columns.forEach(function (col, index) {
                                    // grid.autoFitColumn(index);
                                });
                            }
                     });
                 },
                 error: function (xhr) {
                     console.log("Error: ", xhr.responseText);
                 }
             });
    }

      $('#plusIcon').on('click', function () {                
                 $('#listSection').hide();
                 $('#NewSection').show();
                 $("#rulename").val("");
                $("#tdsType").val("");
              
                $("#beneCategory").val("");
                $("#panstatus").val("");
                $("#pancat").val("");
                $("#tdsrate").val("");
         });
     $('#listIcon1').on('click', function () {
                 $('#listSection').show();
                 $('#NewSection').hide();
      });     
  
    function ruleenginesave() {
        var isValid = true;
        var rule_gid = $("#rule_gid").val();
        var rulename = $("#rulename").val();
        var tdsType = $("#tdsType").val();
        var beneCategory = $("#beneCategory").val();
        var panstatus = $("#panstatus").val();
        var pancat = $("#pancat").val();
        var tdsrate = $("#tdsrate").val();

        if(rulename === "") {
                $("#queryrname").text("Please Enter Rulename");
                isValid = false;
        } else {
                $("#queryrname").text("");
        }
         if(tdsType === "") {
                $("#querytdstype").text("Please Select TDS Type");
                isValid = false;
        } else {
                $("#querytdstype").text("");
        }
         if(beneCategory === "") {
                $("#querybcat").text("Please Select Bene Category");
                isValid = false;
        } else {
                $("#querybcat").text("");
        }
        if(panstatus === "") {
                $("#querypanstatus").text("Please Select Pan Status");
                isValid = false;
        } else {
                $("#querypanstatus").text("");
        }
        if(pancat === "") {
                $("#querypancat").text("Please Select Pan Category");
                isValid = false;
        } else {
                $("#querypancat").text("");
        }
        if(tdsrate === "") {
                $("#querytdsrate").text("Please Enter TDS Rate");
                isValid = false;
        } else {
                $("#querytdsrate").text("");
        }
          if(isValid) {
               var mymodel = {
                   rulegid:rule_gid,
                   rulename:rulename,
                   tdstype:tdsType,
                   benecategory:beneCategory,
                   panstatus:panstatus,
                   pancat:pancat,
                   tdsrate:tdsrate,
                   action: (Number($("#rule_gid").val()) === 0 ? "I" : "U"),
                   user:"@userName"
               }
               $.ajax({
                    type: "Post",
                       url: '@Url.Action("IudRuleEngine", "RuleEngine")',
                       data: JSON.stringify(mymodel),
                       dataType: "json",
                       contentType: 'application/json; charset=utf-8',
                       success: function (response) {
                            var res = JSON.parse(response._data);
                            console.log("Parsed Result:", res);
                                          if (res.length > 0 && res[0].out_msg.includes("Rule engine")) {
                                            $.alert({
                                                title: 'STA Web',
                                                content: res[0].out_msg,
                                                type: 'green',
                                            });
                                            setTimeout(() => {
                                                window.location.href = "../RuleEngine/RuleEngine";
                                            }, 3000);
                                        }
                       }
               });
          }
    }

</script>